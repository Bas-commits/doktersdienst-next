# Kopieer naar `.env.local` en vul aan waar nodig.

# Auth: na sign-up stuurt Better Auth automatisch een bevestigingsmail (React-e-mail),
# zolang `emailVerification.sendVerificationEmail` en Resend zijn geconfigureerd; zie `src/lib/auth.ts`.

# Volledige URL naar het logo voor React-e-mail (object storage of andere CDN).
# Gebruikt door `email/*` templates; zie `DoktersdienstShell`.
EMAIL_LOGO_URL=https://nbg1.your-objectstorage.com/doktersdienst-public/logo.png

# Optioneel: absolute pad voor PBX .txt-bestanden (niet in public/). Vereist in Docker/production.
# TEL_RECORDS_DIR=/var/lib/doktersdienst/telrecords

# PBX CLI (`npm run tel-server-sync`, `tel-server-sync:send`) laadt root `.env` / `.env.local` via `scripts/load-root-env.cjs`; zelfde variabelen als de Next-app.

# PBX-telrecords genereren via de app/API: lookahead in seconden voor diensten (zelfde als CLI tel-server-sync).
# TEL_SYNC_TIJD_VOORUIT=604800

# Playwright e2e-tests (npm run test:e2e): login van een secretaris-account, gebruikt door
# e2e/overnames.spec.ts, rooster-inzien.spec.ts, rooster-maken-secretaris.spec.ts, voorkeuren.spec.ts.
# Ontbreken deze, dan worden die tests overgeslagen (test.skip) i.p.v. te falen.
# PLAYWRIGHT_SECRETARIS_EMAIL=
# PLAYWRIGHT_SECRETARIS_PASSWORD=

# Playwright e2e-tests voor de praktijkplanner (e2e/praktijkplanner.spec.ts). Optioneel per rol.
# PLAYWRIGHT_PP_DEELNEMER_EMAIL=
# PLAYWRIGHT_PP_DEELNEMER_PASSWORD=
# PLAYWRIGHT_PP_SECRETARIS_EMAIL=
# PLAYWRIGHT_PP_SECRETARIS_PASSWORD=
# PLAYWRIGHT_PP_ADMIN_EMAIL=
# PLAYWRIGHT_PP_ADMIN_PASSWORD=
